# Copia este fichero a .env y rellénalo. El .env no se sube nunca al repositorio.
# deploy/init_env.py lo crea solo y genera el token y la contraseña del panel.

# ---- Servicio ----
# Puerto y dirección de escucha (instalación nativa: run.py; Docker: puerto publicado)
PORT=8066
# HOST=0.0.0.0
# BIND=0.0.0.0

# ---- Seguridad (obligatorio si el servicio es accesible desde internet) ----
# Token de la URL de provisión: los teléfonos piden http(s)://servidor/p/<token>/
PROV_TOKEN=
# Usuario y contraseña del panel web
PANEL_USER=admin
PANEL_PASSWORD=
# Redes que pueden provisionar (vacío = cualquiera). Ej.: 203.0.113.10/32,192.168.10.0/24
PROV_ALLOWED_CIDRS=
# Redes que pueden abrir el panel (vacío = cualquiera)
PANEL_ALLOWED_CIDRS=
# Proxies inversos de confianza: de ellos se acepta la cabecera X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12

# ---- Teléfonos ----
# Contraseñas web que se dejan en los teléfonos (admin y user)
PHONE_ADMIN_PASSWORD=
PHONE_USER_PASSWORD=
# Nombre del perfil SIP en las bases Grandstream
# GS_PROFILE_NAME=profile1
# Clave API global del vPBX (opcional; lo normal es pegar la de cada centralita en el panel)
# VPBX_API_KEY=

# ---- Asistente RING (/ring), opcional: túnel OpenVPN de routers MikroTik a un hub ----
# Sin RING_HUB_HOST, RING_HUB_IP y RING_TUN_NET el asistente queda desactivado.
# RING_HUB_NAME=HUB
# RING_HUB_HOST=vpn.ejemplo.com
# RING_HUB_IP=203.0.113.1
# RING_TUN_NET=10.99.0
# IPs de gestión que pueden entrar por Winbox a los routers (separadas por comas)
# RING_MGMT_IPS=203.0.113.10,203.0.113.11
# IP del servidor de monitorización SNMP (vacío = sin regla)
# RING_MONITOR_IP=203.0.113.20
# Nombre de la address-list del hub con las IPs de gestión y cadena NAT para SNMP
# RING_HUB_ACL=GESTION
# RING_HUB_SNMP_CHAIN=dstnat
# RING_WINBOX_BASE=8300
# RING_SNMP_BASE=50000

# ---- IA para hojas de trabajo difíciles (opcional, desactivada por defecto) ----
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://servidor:11434
# LLM_MODEL=qwen2.5:14b
